+                        v -> onSettingChanged(v, TaskbarActivityContext::isHideNavHandle));
+        cleanupTasks.addCloseable(getTaskbarUiThread(), hideNavHandleSafeCloseable);
+
         SimpleBroadcastReceiver shutdownReceiver = new SimpleBroadcastReceiver(
                 mBaseContext,
                 UI_HELPER_EXECUTOR,

